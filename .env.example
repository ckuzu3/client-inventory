# Copy to .env for local development. Never commit a filled-in copy.

# SQLite for a quick start, PostgreSQL for anything else.
CLIENT_INVENTORY_DATABASE_URL=sqlite+pysqlite:///./client-inventory.sqlite3
# CLIENT_INVENTORY_DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory

# The baseline every reported client is measured against.
CLIENT_INVENTORY_BASELINE__MINIMUM_OS_VERSION=10.0.26100
CLIENT_INVENTORY_BASELINE__REQUIRE_ENCRYPTION=true
CLIENT_INVENTORY_BASELINE__MAXIMUM_PATCH_AGE_DAYS=35
CLIENT_INVENTORY_BASELINE__MAXIMUM_LAST_SEEN_AGE_DAYS=14
CLIENT_INVENTORY_BASELINE__MINIMUM_DISK_FREE_PERCENT=10.0

# Origins the browser frontend is served from.
CLIENT_INVENTORY_CORS_ORIGINS=["http://localhost:4200"]
